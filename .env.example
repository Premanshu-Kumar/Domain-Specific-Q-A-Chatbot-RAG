# ============================================
# LLM Configuration (Phase 2)
# ============================================
# Primary: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Groq (fast & free-tier friendly)
# GROQ_API_KEY=your_groq_api_key_here

# Model name (examples)
# OpenAI: gpt-3.5-turbo | gpt-4o-mini | gpt-4o
# Groq:   llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768
LLM_MODEL=gpt-3.5-turbo

# Provider: auto | openai | groq | stub
# "auto" picks OpenAI if OPENAI_API_KEY is set, else Groq, else stub
LLM_PROVIDER=auto

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ============================================
# Embedding Model
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# ============================================
# Vector Store
# ============================================
VECTORSTORE_DIR=./vectorstore
COLLECTION_NAME=rag_documents

# ============================================
# Chunking
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# Retrieval
# ============================================
TOP_K=5
MIN_SIMILARITY=0.0
